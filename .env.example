# Helm — Environment Variables
# Copy to .env.local and fill in. Never commit .env.local.

# ──────────────────────────────────────────────────────────
# APP CONFIG
# ──────────────────────────────────────────────────────────
ENV=development
LOG_LEVEL=info
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
# Comma-separated origins the API accepts from the browser.
# In prod this is the Vercel domain; local dev points at Next's port.
WEB_ORIGIN_ALLOWLIST=http://localhost:3000

# ──────────────────────────────────────────────────────────
# CORE AI — Anthropic
# ──────────────────────────────────────────────────────────
# Get from https://console.anthropic.com
# Phase 1 requirement; Phase 0 does not call Anthropic.
ANTHROPIC_API_KEY=

# ──────────────────────────────────────────────────────────
# INTEGRATION LAYER — Composio
# ──────────────────────────────────────────────────────────
# Platform key from https://app.composio.dev
COMPOSIO_API_KEY=
COMPOSIO_MCP_URL=https://mcp.composio.dev
# Shared secret for verifying incoming /webhooks/composio requests.
# Get from Composio dashboard → Settings → Webhooks.
COMPOSIO_WEBHOOK_SECRET=

# ──────────────────────────────────────────────────────────
# MONEY — Stripe
# ──────────────────────────────────────────────────────────
# Platform mode keys. Stay on test mode until user explicitly flips live.
STRIPE_SECRET_KEY=sk_test_
STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_ISSUING_ENABLED=false

# ──────────────────────────────────────────────────────────
# COMMERCE — Shopify
# ──────────────────────────────────────────────────────────
SHOPIFY_PARTNER_API_KEY=
SHOPIFY_PARTNER_API_SECRET=
SHOPIFY_APP_URL=
SHOPIFY_AGENTIC_PLAN_ENABLED=false

# ──────────────────────────────────────────────────────────
# AUTH + DATA — Supabase (replaces Clerk + Fly Postgres in the build kit)
# ──────────────────────────────────────────────────────────
# Supabase project settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Legacy HS256 JWT secret from Supabase settings (optional; prefer JWKS/RS256)
SUPABASE_JWT_SECRET=

# Supabase Postgres connection string (Settings → Database → Connection string → URI)
# Format: postgresql+asyncpg://postgres.<ref>:<pw>@<host>:5432/postgres
DATABASE_URL=

# ──────────────────────────────────────────────────────────
# REDIS + WORKFLOWS
# ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# Temporal Cloud (Phase 1+)
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=helm
TEMPORAL_CERT_PATH=
TEMPORAL_KEY_PATH=

# ──────────────────────────────────────────────────────────
# OBSERVABILITY
# ──────────────────────────────────────────────────────────
SENTRY_DSN=

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# ──────────────────────────────────────────────────────────
# SECRETS VAULT (Phase 1+)
# ──────────────────────────────────────────────────────────
DOPPLER_TOKEN=

# ──────────────────────────────────────────────────────────
# NOTIFICATIONS (Phase 4)
# ──────────────────────────────────────────────────────────
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_PATH=
APNS_TOPIC=com.helm.app
FCM_SERVICE_ACCOUNT_JSON=
RESEND_API_KEY=

# ──────────────────────────────────────────────────────────
# AD PLATFORMS (platform-level; per-business via Composio OAuth)
# ──────────────────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_MARKETING_API_VERSION=v21.0
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=

# ──────────────────────────────────────────────────────────
# CREATIVE GENERATION FALLBACKS
# ──────────────────────────────────────────────────────────
REPLICATE_API_TOKEN=
OPENAI_API_KEY=

# ──────────────────────────────────────────────────────────
# DEFAULTS / FEATURE FLAGS
# ──────────────────────────────────────────────────────────
DEFAULT_WEEKLY_SPEND_CAP_CENTS=50000
DEFAULT_PER_AUTH_CAP_CENTS=50000
DEFAULT_APPROVAL_THRESHOLD_CENTS=10000

ENABLE_COMPUTER_USE=false
ENABLE_SAAS_VERTICAL=false
ENABLE_INTERNATIONAL=false
