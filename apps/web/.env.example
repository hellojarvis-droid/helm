NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_HELM_API_BASE=http://localhost:8000

# Sentry (optional — leave unset to disable. Setting NEXT_PUBLIC_SENTRY_DSN
# enables client + server + edge runtime error tracking and turns on the
# Sentry webpack plugin at build time.)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENV=development
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
