{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Helm",
  "version": "0.0.0",
  "identifier": "app.helm.desktop",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "http://localhost:3000",
    "frontendDist": "http://localhost:3000"
  },
  "app": {
    "windows": [
      {
        "title": "Helm",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "url": "http://localhost:3000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "© 2026 Helm",
    "category": "Productivity",
    "shortDescription": "The OS for one-person holding companies.",
    "longDescription": "Helm — one CEO Agent, eight specialists, real Stripe-issued virtual cards with programmatic spend controls."
  }
}
